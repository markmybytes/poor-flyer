#!/command/with-contenv sh
# shellcheck shell=sh

PUID=${PUID:-911}
PGID=${PGID:-911}

groupmod -o -g "$PGID" abc
usermod -o -u "$PUID" abc

# Ensure writable runtime paths exist after UID/GID remap.
mkdir -p /app/data
chown -R abc:abc /app/data


echo '
───────────────────────────────────────
GID/UID
───────────────────────────────────────'
echo "
User UID:    $(id -u abc)
User GID:    $(id -g abc)
───────────────────────────────────────
"