# Core app
DATABASE_URL=sqlite:////app/data/db.sqlite
# Optional: override default sqlite file used when DATABASE_URL is not set
# DATABASE_PATH=./data/db.sqlite

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_SCRAPE_CRON_HOUR=9
SCHEDULER_SCRAPE_CRON_MINUTE=0
SCHEDULER_SCRAPE_JITTER_SECONDS=1800

# Frontend hot-reload marker file
# VITE_HOT_FILE=src/static/dist/hot
